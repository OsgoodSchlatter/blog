---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  cover?: string;
}
const { title, description, date, tags = [], cover } = Astro.props;
const formatted = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Layout title={title} description={description}>
  <article>
    <header class="article-header">
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{formatted}</time>
        {tags.length > 0 && (
          <span class="tags">
            {tags.map((t) => <span class="tag">{t}</span>)}
          </span>
        )}
      </div>
    </header>
    {cover && <img class="cover" src={cover} alt="" />}
    <div class="prose">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .article-header { margin-bottom: 1.5em; }
  .meta {
    font-family: var(--sans);
    font-size: 0.85em;
    color: var(--muted);
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .tags { display: flex; gap: 6px; }
  .tag {
    background: #eee7d7;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .cover { margin: 1.5em 0; width: 100%; max-height: 420px; object-fit: cover; }
</style>
